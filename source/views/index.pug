<!DOCTYPE html>
html(lang="en")
head
  title DevTips Starter Kit
  meta(charset="UTF-8")
  meta(name="viewport", content="width=device-width, initial-scale=1")
  link(rel="shortcut icon", href="./assets/img/favicons/favicon.ico")
  link(rel="stylesheet", href="assets/css/main.css")
body
  .page-home
    section
      h1.page-title DevTips<br>Starter Kit 
      p Ground zero for your next project. eine update von dev-tips Starter Kit. 
      a.button.button-download(href="https://github.com/devtips/devtips-starter-kit/archive/master.zip") Download Now
      a.fork-tag(href="https://github.com/DevTips/DevTips-Starter-Kit") Fork Me on GitHub
    section
      article
        img(src="assets/img/starter-kit-cover.png", alt="starter-kit-hintergrund")
        h4 Update from Travis Neilson Devtips Starter Kit
        p Tnn Travis Neilson Devtips Starter Kit
        .name-lockup
          .name
            strong Travis Neilson
            br
